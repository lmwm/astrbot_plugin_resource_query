{
    "modules": {
        "description": "功能模块开关",
        "type": "object",
        "hint": "关闭的模块不会加载，其指令与配置页同时隐藏；模块自身的配置在插件 Pages 页面中管理",
        "items": {
            "mimo_enabled": {
                "description": "启用 MiMo 查询",
                "type": "bool",
                "default": true,
                "hint": "小米 MiMo 平台余额与用量查询"
            },
            "wasu_enabled": {
                "description": "启用华数查询",
                "type": "bool",
                "default": true,
                "hint": "华数广电流量 / 话费 / 余量查询"
            },
            "jm_enabled": {
                "description": "启用 JM 下载",
                "type": "bool",
                "default": true,
                "hint": "JMComic 漫画下载（仅私聊）"
            },
            "update_enabled": {
                "description": "启用插件更新",
                "type": "bool",
                "default": true,
                "hint": "通过 /query update 检查并更新插件自身"
            }
        }
    }
}
