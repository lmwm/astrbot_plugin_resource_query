{
    "modules": {
        "description": "模块启用设置",
        "type": "object",
        "items": {
            "mimo_enabled": {
                "description": "启用 MiMo 模块",
                "type": "bool",
                "default": true,
                "hint": "小米 MiMo 平台用量查询功能"
            },
            "wasu_enabled": {
                "description": "启用华数模块",
                "type": "bool",
                "default": true,
                "hint": "华数广电流量/话费查询功能"
            },
            "jm_enabled": {
                "description": "启用 JM 模块",
                "type": "bool",
                "default": true,
                "hint": "JMComic 漫画下载功能"
            }
        }
    },
    "proxy": {
        "description": "GitHub 更新代理",
        "type": "string",
        "default": "https://gh-proxy.cn/",
        "hint": "用于 GitHub 更新请求的代理地址，留空禁用代理"
    },
    "update_max_retries": {
        "description": "更新最大重试次数",
        "type": "int",
        "default": 3,
        "hint": "自动更新时网络请求失败的重试次数"
    }
}
